{
  "name": "arrival",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:portless": "portless prune && portless",
    "dev:prune": "pnpm exec tsx scripts/proxy/prune.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "type-check:ci": "tsc --noEmit --incremental false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "ANALYZE=true next build",
    "redis": "pnpm exec tsx --env-file=.env scripts/redis/index.ts",
    "redis:clear:ratelimit": "pnpm exec tsx --env-file=.env scripts/redis/clear-ratelimit.ts",
    "redis:clear:emails": "pnpm exec tsx --env-file=.env scripts/redis/clear-emails.ts",
    "redis:flush": "pnpm exec tsx --env-file=.env scripts/redis/flush-all.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@clerk/elements": "0.24.16",
    "@clerk/nextjs": "6.39.3",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@upstash/workflow": "^1.2.0",
    "@vercel/analytics": "^2.0.1",
    "@zerobounce/zero-bounce-sdk": "^2.1.1",
    "botid": "^1.5.11",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.74.0",
    "resend": "^6.12.2",
    "sonner": "^2.0.7",
    "svix": "^1.92.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "portless": "^0.14.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.6.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.11.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.2.2",
      "onFail": "download"
    }
  }
}
